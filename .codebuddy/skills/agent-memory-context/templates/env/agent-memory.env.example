# Agent-Memory runtime environment example
# Copy values into your shell profile, PowerShell user environment, IDE environment, or a local env loader.

AGENT_MEMORY_CODE_CONTEXT_BIN=/path/to/agent-memory/bin/code-context
# Milvus Docker mode and Milvus Lite server mode both expose localhost:19530 by default.
AGENT_MEMORY_VECTOR_STORE=milvus
AGENT_MEMORY_MILVUS_ADDRESS=localhost:19530
AGENT_MEMORY_MILVUS_COLLECTION=agent_memory_chunks

# Choose one embedding provider.
AGENT_MEMORY_EMBEDDING_PROVIDER=hash

# Ollama local embedding example.
# AGENT_MEMORY_EMBEDDING_PROVIDER=ollama
# AGENT_MEMORY_OLLAMA_HOST=http://127.0.0.1:11434
# AGENT_MEMORY_OLLAMA_EMBEDDING_MODEL=embeddinggemma

# OpenAI-compatible embedding example.
# AGENT_MEMORY_EMBEDDING_PROVIDER=openai-compatible
# AGENT_MEMORY_OPENAI_BASE_URL=https://api.openai.com/v1
# AGENT_MEMORY_OPENAI_API_KEY=replace-with-your-api-key
# AGENT_MEMORY_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# AGENT_MEMORY_OPENAI_MAX_INPUT_LENGTH=8192
