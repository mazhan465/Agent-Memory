{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON_CMD}} \"$CODEBUDDY_PROJECT_DIR\"/.codebuddy/skills/agent-memory-context/hooks/agent_memory_hook.py session-start",
            "timeout": 120
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON_CMD}} \"$CODEBUDDY_PROJECT_DIR\"/.codebuddy/skills/agent-memory-context/hooks/agent_memory_hook.py prompt",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON_CMD}} \"$CODEBUDDY_PROJECT_DIR\"/.codebuddy/skills/agent-memory-context/hooks/agent_memory_hook.py sync",
            "timeout": 120
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "clear|logout|prompt_input_exit|other",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON_CMD}} \"$CODEBUDDY_PROJECT_DIR\"/.codebuddy/skills/agent-memory-context/hooks/agent_memory_hook.py sync",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
